# Copy to .env for local dev (netlify dev reads this), and set the
# same values in the Netlify dashboard under Site settings >
# Environment variables for the deployed site.

# --- Required ---
MONGODB_URI=
JWT_SECRET=

# --- Email (staff invites) — at least ONE required for invites to send ---
# Priority order: Resend, then Brevo, then SendGrid, then Mailgun.
# Unset ones are skipped, not treated as an error.
RESEND_API_KEY=
BREVO_API_KEY=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
EMAIL_FROM=no-reply@yourdomain.org
SITE_URL=https://your-site.netlify.app

# --- Optional: daily send caps per provider, used by the email load ---
# balancer to detect "out of quota" before the provider does. Defaults
# in code are placeholders — check your actual plan on each provider's
# dashboard and set these to match.
RESEND_DAILY_LIMIT=
BREVO_DAILY_LIMIT=
SENDGRID_DAILY_LIMIT=
MAILGUN_DAILY_LIMIT=
